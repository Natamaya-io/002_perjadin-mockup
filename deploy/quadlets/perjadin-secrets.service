[Unit]
Description=Fetch Perjadin Secrets from Doppler to RAM Disk
Before=perjadin-db.service perjadin-redis.service perjadin-gotenberg.service perjadin-backend.service perjadin-frontend.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'doppler secrets download --no-file --format docker > /dev/shm/perjadin.env && echo POSTGRES_USER=$(doppler secrets get DB_USER --plain) >> /dev/shm/perjadin.env && echo POSTGRES_PASSWORD=$(doppler secrets get DB_PASSWORD --plain) >> /dev/shm/perjadin.env && echo POSTGRES_DB=$(doppler secrets get DB_NAME --plain) >> /dev/shm/perjadin.env'
# Ensure /dev/shm/perjadin.env has strict permissions so only the owner can read it
ExecStartPost=/bin/chmod 600 /dev/shm/perjadin.env
RemainAfterExit=yes

[Install]
WantedBy=default.target
